{
  "name": "api-gerenciador-de-tarefas",
  "version": "1.0.0",
  "description": "API RESTful de gerenciamento de tarefas construida com Clean Architecture (Node.js + Express + Sequelize + SQLite).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "npm run swagger && nodemon src/server.js",
    "swagger": "node swagger.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "seed": "node scripts/seed.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "keywords": [
    "api",
    "rest",
    "express",
    "sequelize",
    "sqlite",
    "clean-architecture"
  ],
  "author": "Felipe Mesquita Pinto <mesquitafelipe409@gmail.com>",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "swagger-autogen": "^2.23.7"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "contributors": [
    "Felipe Mesquita Pinto",
    "Wheverson de Abreu Lima"
  ]
}
