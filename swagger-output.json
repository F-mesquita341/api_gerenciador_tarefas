        },
        "titulo": {
          "type": "string",
          "example": "Modelar o banco de dados"
        },
        "descricao": {
          "type": "string",
          "example": "Definir as tabelas de usuários e tarefas"
        },
        "status": {
          "type": "string",
          "example": "EM_ANDAMENTO"
        },
        "usuarioId": {
          "type": "number",
          "example": 1
        }
      }
    },
    "TarefaConcluida": {
